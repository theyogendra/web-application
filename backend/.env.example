# Copy to backend/.env and fill in real values.
# Never commit the real .env (root .gitignore covers all .env files).

# ---- Supabase ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# Mirrors of the above so any "NEXT_PUBLIC_*" code path resolves the same value.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ---- App ----
PORT=8000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=https://localhost:3000

# HTTPS on by default. A self-signed cert is auto-generated under
# backend/certs/ on first start. Set to "false" only if you truly need
# plain HTTP (e.g. behind a TLS-terminating proxy that already does HTTPS).
ENABLE_HTTPS=true

# Optional extra CORS origins (comma-separated). localhost:3000/3001
# (http + https) and APP_URL are always allowed.
# CORS_ORIGINS=https://your-deployed-frontend.example.com

# ---- Email (Resend) ----
# Leave RESEND_API_KEY blank to run in no-op mode — emails are logged with
# status='skipped' instead of sent.
RESEND_API_KEY=
FROM_EMAIL=Enterprise <onboarding@resend.dev>
REPLY_TO_EMAIL=

# ---- Default admin (used by the users/roles migration to seed the first row) ----
ADMIN_EMAIL=admin@enterprise.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Administrator
