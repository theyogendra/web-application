# Ignore Node modules and build files
node_modules/
dist/
build/
.next/
out/
# Secrets — never commit any .env file anywhere in the repo.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# TLS — never commit a private key. Self-signed certs are auto-generated
# on first backend start under backend/certs/.
**/certs/
*.pem
*.crt
*.key

# Backups and temporary files
_backup_root_duplicates/
*.db
*.sqlite

# Python leftovers
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
pip-log.txt
pip-delete-this-directory.txt

# OS metadata
.DS_Store
Thumbs.db
